apiVersion: v1
kind: Service
metadata:
  name: backend
  namespace: k6-lab
spec:
  selector:
    app: ecommerce-backend
  ports:
    - name: http
      port: 3000
      targetPort: http
---
apiVersion: v1
kind: Service
metadata:
  name: ecommerce-frontend
  namespace: k6-lab
spec:
  selector:
    app: ecommerce-frontend
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ecommerce-backend
  namespace: k6-lab
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: ecommerce-backend
  template:
    metadata:
      labels:
        app: ecommerce-backend
    spec:
      automountServiceAccountToken: false
      containers:
        - name: ecommerce-backend
          image: __BACKEND_IMAGE__
          imagePullPolicy: IfNotPresent
          args: ["node", "server.js"]
          env:
            - {name: DB_PATH, value: /var/lib/toko/toko.db}
            - {name: NODE_OPTIONS, value: "--require=/opt/otel/instrumentation.cjs"}
            - {name: OTEL_SERVICE_NAME, value: petite-bow-backend}
            - {name: OTEL_RESOURCE_ATTRIBUTES, value: "service.version=1.1.0-trace.2,deployment.environment.name=k6-lab"}
            - {name: OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, value: "http://alloy:4318/v1/traces"}
            - {name: OTEL_TRACES_SAMPLER, value: parentbased_always_on}
            - {name: OTEL_METRICS_EXPORTER, value: none}
            - {name: OTEL_LOGS_EXPORTER, value: none}
            - {name: OTEL_BSP_SCHEDULE_DELAY, value: "1000"}
          ports:
            - {name: http, containerPort: 3000}
          readinessProbe:
            tcpSocket:
              port: http
            periodSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
          volumeMounts:
            - name: sqlite
              mountPath: /var/lib/toko
      volumes:
        - name: sqlite
          persistentVolumeClaim:
            claimName: petite-bow-sqlite
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ecommerce-frontend
  namespace: k6-lab
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ecommerce-frontend
  template:
    metadata:
      labels:
        app: ecommerce-frontend
    spec:
      automountServiceAccountToken: false
      containers:
        - name: ecommerce-frontend
          image: __FRONTEND_IMAGE__
          imagePullPolicy: IfNotPresent
          ports:
            - {name: http, containerPort: 80}
          readinessProbe:
            tcpSocket:
              port: http
            periodSeconds: 5
          resources:
            requests:
              cpu: 50m
              memory: 32Mi
